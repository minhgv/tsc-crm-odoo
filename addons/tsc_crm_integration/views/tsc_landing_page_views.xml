<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tsc_landing_page_view_form" model="ir.ui.view">
        <field name="name">tsc.landing.page.form</field>
        <field name="model">tsc.landing.page</field>
        <field name="arch" type="xml">
            <form string="Landing Page">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="slogan"/>
                            <field name="seo_title"/>
                        </group>
                        <group>
                            <field name="logo" widget="image"/>
                            <field name="banner" widget="image"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="seo_description"/>
                    <field name="service_ids" widget="many2many_tags"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tsc_landing_page_view_tree" model="ir.ui.view">
        <field name="name">tsc.landing.page.tree</field>
        <field name="model">tsc.landing.page</field>
        <field name="arch" type="xml">
            <list string="Landing Pages">
                <field name="name"/>
                <field name="slogan"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="tsc_landing_page_action" model="ir.actions.act_window">
        <field name="name">Landing Pages</field>
        <field name="res_model">tsc.landing.page</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
