<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tsc_notification_template_view_form" model="ir.ui.view">
        <field name="name">tsc.notification.template.form</field>
        <field name="model">tsc.notification.template</field>
        <field name="arch" type="xml">
            <form string="Notification Template">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="notification_type"/>
                            <field name="trigger_event"/>
                        </group>
                        <group>
                            <field name="subject"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="body" placeholder="Message body..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tsc_notification_template_view_tree" model="ir.ui.view">
        <field name="name">tsc.notification.template.tree</field>
        <field name="model">tsc.notification.template</field>
        <field name="arch" type="xml">
            <list string="Notification Templates">
                <field name="name"/>
                <field name="notification_type"/>
                <field name="trigger_event"/>
            </list>
        </field>
    </record>

    <record id="tsc_notification_template_action" model="ir.actions.act_window">
        <field name="name">Notification Templates</field>
        <field name="res_model">tsc.notification.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="tsc_notification_log_view_tree" model="ir.ui.view">
        <field name="name">tsc.notification.log.tree</field>
        <field name="model">tsc.notification.log</field>
        <field name="arch" type="xml">
            <list string="Notification Logs">
                <field name="template_id"/>
                <field name="recipient"/>
                <field name="notification_type"/>
                <field name="state"/>
                <field name="sent_date"/>
            </list>
        </field>
    </record>

    <record id="tsc_notification_log_action" model="ir.actions.act_window">
        <field name="name">Notification Logs</field>
        <field name="res_model">tsc.notification.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
