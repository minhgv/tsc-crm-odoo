<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tsc_integration_config_view_form" model="ir.ui.view">
        <field name="name">tsc.integration.config.form</field>
        <field name="model">tsc.integration.config</field>
        <field name="arch" type="xml">
            <form string="Integration Configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="system"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="api_url"/>
                            <field name="api_key" password="True"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tsc_integration_config_view_tree" model="ir.ui.view">
        <field name="name">tsc.integration.config.tree</field>
        <field name="model">tsc.integration.config</field>
        <field name="arch" type="xml">
            <list string="Integration Configurations">
                <field name="name"/>
                <field name="system"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="tsc_integration_config_action" model="ir.actions.act_window">
        <field name="name">Integration Configurations</field>
        <field name="res_model">tsc.integration.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="tsc_integration_log_view_tree" model="ir.ui.view">
        <field name="name">tsc.integration.log.tree</field>
        <field name="model">tsc.integration.log</field>
        <field name="arch" type="xml">
            <list string="Integration Logs">
                <field name="config_id"/>
                <field name="direction"/>
                <field name="state"/>
                <field name="created_date"/>
            </list>
        </field>
    </record>

    <record id="tsc_integration_log_action" model="ir.actions.act_window">
        <field name="name">Integration Logs</field>
        <field name="res_model">tsc.integration.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
