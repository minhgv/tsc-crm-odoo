<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tsc_promotion_view_form" model="ir.ui.view">
        <field name="name">tsc.promotion.form</field>
        <field name="model">tsc.promotion</field>
        <field name="arch" type="xml">
            <form string="Promotion">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Promotion Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="promo_type"/>
                            <field name="value"/>
                            <field name="scope"/>
                        </group>
                        <group>
                            <field name="service_id"/>
                            <field name="package_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tsc_promotion_view_tree" model="ir.ui.view">
        <field name="name">tsc.promotion.tree</field>
        <field name="model">tsc.promotion</field>
        <field name="arch" type="xml">
            <list string="Promotions">
                <field name="name"/>
                <field name="promo_type"/>
                <field name="value"/>
                <field name="scope"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="tsc_promotion_action" model="ir.actions.act_window">
        <field name="name">Promotions</field>
        <field name="res_model">tsc.promotion</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
