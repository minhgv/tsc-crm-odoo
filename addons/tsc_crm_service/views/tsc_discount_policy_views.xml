<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tsc_discount_policy_view_form" model="ir.ui.view">
        <field name="name">tsc.discount.policy.form</field>
        <field name="model">tsc.discount.policy</field>
        <field name="arch" type="xml">
            <form string="Discount Policy">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Policy Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="discount_type"/>
                            <field name="discount_mode"/>
                            <field name="value"/>
                        </group>
                        <group>
                            <field name="scope"/>
                            <field name="agency_ids" widget="many2many_tags"
                                   invisible="scope != 'specific_agent'"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tsc_discount_policy_view_tree" model="ir.ui.view">
        <field name="name">tsc.discount.policy.tree</field>
        <field name="model">tsc.discount.policy</field>
        <field name="arch" type="xml">
            <list string="Discount Policies">
                <field name="name"/>
                <field name="discount_type"/>
                <field name="discount_mode"/>
                <field name="value"/>
                <field name="scope"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="tsc_discount_policy_action" model="ir.actions.act_window">
        <field name="name">Discount Policies</field>
        <field name="res_model">tsc.discount.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
