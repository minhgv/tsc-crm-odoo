<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tsc_discount_view_form" model="ir.ui.view">
        <field name="name">tsc.discount.form</field>
        <field name="model">tsc.discount</field>
        <field name="arch" type="xml">
            <form string="Discount">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Discount Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="discount_type"/>
                            <field name="service_id"/>
                            <field name="package_id"/>
                            <field name="agency_id"/>
                        </group>
                        <group>
                            <field name="percentage"/>
                            <field name="amount"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tsc_discount_view_tree" model="ir.ui.view">
        <field name="name">tsc.discount.tree</field>
        <field name="model">tsc.discount</field>
        <field name="arch" type="xml">
            <list string="Discounts">
                <field name="name"/>
                <field name="discount_type"/>
                <field name="service_id"/>
                <field name="percentage"/>
                <field name="amount"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="tsc_discount_action" model="ir.actions.act_window">
        <field name="name">Discounts</field>
        <field name="res_model">tsc.discount</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
