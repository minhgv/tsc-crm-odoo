<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tsc_package_view_form" model="ir.ui.view">
        <field name="name">tsc.package.form</field>
        <field name="model">tsc.package</field>
        <field name="arch" type="xml">
            <form string="Package">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Package Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="service_id"/>
                            <field name="package_type"/>
                            <field name="deployment_fee"/>
                        </group>
                        <group>
                            <field name="trial_days"/>
                            <field name="validity_days"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Levels" name="levels">
                            <field name="level_ids"/>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tsc_package_view_tree" model="ir.ui.view">
        <field name="name">tsc.package.tree</field>
        <field name="model">tsc.package</field>
        <field name="arch" type="xml">
            <list string="Packages">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="service_id"/>
                <field name="package_type"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="tsc_package_action" model="ir.actions.act_window">
        <field name="name">Packages</field>
        <field name="res_model">tsc.package</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
