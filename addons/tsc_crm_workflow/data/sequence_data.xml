<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_tsc_order" model="ir.sequence">
        <field name="name">TSC Order</field>
        <field name="code">tsc.order</field>
        <field name="prefix">ORD</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_tsc_contract" model="ir.sequence">
        <field name="name">TSC Contract</field>
        <field name="code">tsc.contract</field>
        <field name="prefix">CT</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_tsc_invoice" model="ir.sequence">
        <field name="name">TSC Invoice</field>
        <field name="code">tsc.invoice</field>
        <field name="prefix">INV</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_tsc_payment" model="ir.sequence">
        <field name="name">TSC Payment</field>
        <field name="code">tsc.payment</field>
        <field name="prefix">PAY</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
