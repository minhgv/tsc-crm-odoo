<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tsc_contract_view_form" model="ir.ui.view">
        <field name="name">tsc.contract.form</field>
        <field name="model">tsc.contract</field>
        <field name="arch" type="xml">
            <form string="Contract">
                <header>
                    <button name="action_submit" string="Submit for Signature" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_send_to_voffice" string="Send to VOffice" type="object" class="oe_highlight" invisible="state != 'draft' or not signed_file"/>
                    <button name="action_check_voffice_status" string="Check VOffice Status" type="object" invisible="state != 'pending_sign'"/>
                    <button name="action_sign" string="Mark Signed" type="object" class="oe_highlight" invisible="state != 'pending_sign'"/>
                    <button name="action_scan" string="Upload Scan" type="object" class="oe_highlight" invisible="state != 'signed'"/>
                    <button name="action_activate" string="Activate" type="object" class="oe_highlight" invisible="state != 'scanned'"/>
                    <button name="action_terminate" string="Terminate" type="object" class="oe_highlight" invisible="state not in ('active', 'signed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending_sign,signed,active"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="lead_id"/>
                            <field name="partner_id"/>
                            <field name="service_id"/>
                            <field name="package_id"/>
                        </group>
                        <group>
                            <field name="contract_date"/>
                            <field name="effective_date"/>
                            <field name="expiry_date"/>
                            <field name="template_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="contract_value"/>
                            <field name="currency_id"/>
                            <field name="billing_cycle"/>
                        </group>
                        <group>
                            <field name="performance_state"/>
                            <field name="created_by"/>
                            <field name="approved_by"/>
                            <field name="approved_date"/>
                            <field name="voffice_doc_id"/>
                            <field name="voffice_status" widget="badge" decoration-danger="voffice_status == 'rejected'" decoration-success="voffice_status == 'signed'" decoration-warning="voffice_status == 'sent'"/>
                        </group>
                    </group>
                    <group>
                        <field name="signed_file" widget="binary" filename="signed_file_name"/>
                        <field name="signed_file_name" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="VOffice Signing" name="voffice">
                            <field name="voffice_config_id" domain="[('active', '=', True)]"/>
                            <field name="voffice_sign_ids" readonly="1">
                                <list>
                                    <field name="doc_id"/>
                                    <field name="status" widget="badge"/>
                                    <field name="error_message"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Audit Log" name="audit">
                            <field name="audit_log_ids" readonly="1"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="tsc_contract_view_tree" model="ir.ui.view">
        <field name="name">tsc.contract.tree</field>
        <field name="model">tsc.contract</field>
        <field name="arch" type="xml">
            <list string="Contracts">
                <field name="name"/>
                <field name="lead_id"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="voffice_status" widget="badge"/>
                <field name="contract_date"/>
            </list>
        </field>
    </record>

    <record id="tsc_contract_action" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">tsc.contract</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
