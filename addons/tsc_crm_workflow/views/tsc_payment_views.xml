<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tsc_payment_view_form" model="ir.ui.view">
        <field name="name">tsc.payment.form</field>
        <field name="model">tsc.payment</field>
        <field name="arch" type="xml">
            <form string="Payment">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'pending'"/>
                    <button name="action_fail" string="Mark Failed" type="object" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="invoice_id"/>
                            <field name="amount"/>
                            <field name="payment_method"/>
                        </group>
                        <group>
                            <field name="payment_date"/>
                            <field name="transaction_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="tsc_payment_view_tree" model="ir.ui.view">
        <field name="name">tsc.payment.tree</field>
        <field name="model">tsc.payment</field>
        <field name="arch" type="xml">
            <list string="Payments">
                <field name="name"/>
                <field name="invoice_id"/>
                <field name="amount"/>
                <field name="payment_method"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="tsc_payment_action" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">tsc.payment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
