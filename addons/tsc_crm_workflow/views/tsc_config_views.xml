<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VAT Config -->
    <record id="tsc_vat_config_view_form" model="ir.ui.view">
        <field name="name">tsc.vat.config.form</field>
        <field name="model">tsc.vat.config</field>
        <field name="arch" type="xml">
            <form string="VAT Configuration">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="rate"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tsc_vat_config_view_tree" model="ir.ui.view">
        <field name="name">tsc.vat.config.tree</field>
        <field name="model">tsc.vat.config</field>
        <field name="arch" type="xml">
            <list string="VAT Configurations">
                <field name="name"/>
                <field name="rate"/>
                <field name="date_from"/>
                <field name="date_to"/>
            </list>
        </field>
    </record>

    <record id="tsc_vat_config_action" model="ir.actions.act_window">
        <field name="name">VAT Configuration</field>
        <field name="res_model">tsc.vat.config</field>
        <field name="view_mode">list,form</field>
    </record>

