<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_tsc_staff_business" model="res.groups">
        <field name="name">TSC / Staff Business</field>
        <field name="comment">Can create and manage orders</field>
    </record>

    <record id="group_tsc_staff_technical" model="res.groups">
        <field name="name">TSC / Staff Technical</field>
        <field name="comment">Can view orders and update technical tasks</field>
    </record>

    <record id="group_tsc_staff_cc" model="res.groups">
        <field name="name">TSC / Staff Customer Care</field>
        <field name="comment">Can view and update customer information</field>
    </record>

    <record id="group_tsc_manager" model="res.groups">
        <field name="name">TSC / Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_tsc_staff_business'))]"/>
        <field name="comment">Can manage staff and view all data in branch</field>
    </record>

    <record id="group_tsc_admin" model="res.groups">
        <field name="name">TSC / Admin</field>
        <field name="comment">Full access to all TSC CRM features</field>
    </record>

    <!-- Record Rules: Branch isolation -->
    <record id="tsc_region_rule_manager" model="ir.rule">
        <field name="name">TSC Region: Manager sees all</field>
        <field name="model_id" ref="model_tsc_region"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_tsc_manager'))]"/>
    </record>

    <record id="tsc_region_rule_staff" model="ir.rule">
        <field name="name">TSC Region: Staff sees all active</field>
        <field name="model_id" ref="model_tsc_region"/>
        <field name="domain_force">[('active', '=', True)]</field>
        <field name="groups" eval="[(4, ref('group_tsc_staff_business'))]"/>
    </record>

    <record id="tsc_order_assignment_rule_manager" model="ir.rule">
        <field name="name">TSC Order Assignment: Manager sees all</field>
        <field name="model_id" ref="model_tsc_order_assignment"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_tsc_manager'))]"/>
    </record>

    <record id="tsc_order_assignment_rule_staff" model="ir.rule">
        <field name="name">TSC Order Assignment: Staff sees all</field>
        <field name="model_id" ref="model_tsc_order_assignment"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_tsc_staff_business'))]"/>
    </record>
</odoo>
