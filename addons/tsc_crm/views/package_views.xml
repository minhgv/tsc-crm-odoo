<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Package Form View -->
    <record id="tsc_package_view_form" model="ir.ui.view">
        <field name="name">tsc.package.form</field>
        <field name="model">tsc.package</field>
        <field name="arch" type="xml">
            <form string="Package">
                <header>
                    <button name="toggle_active" string="Archive"
                            type="object" class="oe_highlight"
                            invisible="active"/>
                    <button name="toggle_active" string="Unarchive"
                            type="object"
                            invisible="active == True"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Package Name"/>
                        </h1>
                        <h3>
                            <field name="code" placeholder="Package Code"/>
                        </h3>
                    </div>
                    <group>
                        <group string="General Information">
                            <field name="service_id"/>
                            <field name="package_type"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="Pricing">
                            <field name="setup_fee"/>
                            <field name="validity_days"/>
                            <field name="trial_days"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <group>
                                <field name="description" placeholder="Package description..."/>
                                <field name="notes" placeholder="Notes..."/>
                            </group>
                        </page>
                        <page string="Price Levels" name="levels">
                            <field name="level_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="price"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Combo" name="combo" invisible="is_combo == False">
                            <field name="is_combo"/>
                            <field name="combo_service_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Package Tree View -->
    <record id="tsc_package_view_tree" model="ir.ui.view">
        <field name="name">tsc.package.tree</field>
        <field name="model">tsc.package</field>
        <field name="arch" type="xml">
            <list string="Packages">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="service_id"/>
                <field name="package_type"/>
                <field name="setup_fee"/>
                <field name="validity_days"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Package Kanban View -->
    <record id="tsc_package_view_kanban" model="ir.ui.view">
        <field name="name">tsc.package.kanban</field>
        <field name="model">tsc.package</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="code"/>
                <field name="service_id"/>
                <field name="package_type"/>
                <field name="setup_fee"/>
                <field name="logo"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('tsc.package', 'logo', record.id.raw_value)"
                                     t-att-alt="record.name.raw_value"
                                     class="o_kanban_image_fill"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="code"/>
                                </div>
                                <div>
                                    <field name="service_id"/>
                                </div>
                                <div>
                                    <field name="package_type"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Package Search View -->
    <record id="tsc_package_view_search" model="ir.ui.view">
        <field name="name">tsc.package.search</field>
        <field name="model">tsc.package</field>
        <field name="arch" type="xml">
            <search string="Search Packages">
                <field name="name"/>
                <field name="code"/>
                <field name="service_id"/>
                <filter name="filter_active" string="Active"
                        domain="[('active','=',True)]"/>
                <filter name="filter_one_time" string="One Time"
                        domain="[('package_type','=','one_time')]"/>
                <filter name="filter_cycle" string="Cycle"
                        domain="[('package_type','=','cycle')]"/>
                <filter name="filter_combo" string="Combo"
                        domain="[('is_combo','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_service" string="Service"
                            context="{'group_by':'service_id'}"/>
                    <filter name="group_type" string="Package Type"
                            context="{'group_by':'package_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Package Action -->
    <record id="tsc_package_action" model="ir.actions.act_window">
        <field name="name">Packages</field>
        <field name="res_model">tsc.package</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="tsc_package_view_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>
</odoo>
