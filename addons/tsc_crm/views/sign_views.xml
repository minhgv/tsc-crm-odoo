<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sign Form View -->
    <record id="tsc_sign_view_form" model="ir.ui.view">
        <field name="name">tsc.sign.form</field>
        <field name="model">tsc.sign</field>
        <field name="arch" type="xml">
            <form string="Signing Record">
                <header>
                    <button name="action_send_to_voffice" string="Send to VOffice"
                            type="object" class="oe_highlight"
                            invisible="voffice_status not in ('none',)"/>
                    <button name="action_check_status" string="Check Status"
                            type="object"
                            invisible="voffice_status not in ('pending',)"/>
                    <button name="action_mark_signed" string="Mark Signed"
                            type="object" class="oe_highlight"
                            invisible="voffice_status not in ('pending',)"/>
                    <button name="action_mark_published" string="Mark Published"
                            type="object" class="oe_highlight"
                            invisible="voffice_status not in ('signed',)"/>
                    <button name="action_mark_rejected" string="Mark Rejected"
                            type="object"
                            invisible="voffice_status not in ('pending', 'signed')"/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="voffice_status in ('published', 'cancelled')"/>
                    <field name="voffice_status" widget="statusbar" statusbar_visible="none,pending,signed,published"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Document Information">
                            <field name="contract_id"/>
                            <field name="lead_id"/>
                            <field name="partner_id"/>
                            <field name="doc_type"/>
                        </group>
                        <group string="VOffice Information">
                            <field name="voffice_doc_id"/>
                            <field name="voffice_trans_code"/>
                            <field name="sign_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Signed File" name="file">
                            <group>
                                <field name="signed_file" filename="signed_filename"/>
                                <field name="signed_filename" invisible="1"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <group>
                                <field name="notes" placeholder="Notes..."/>
                                <field name="error_message" placeholder="Error message..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Sign Tree View -->
    <record id="tsc_sign_view_tree" model="ir.ui.view">
        <field name="name">tsc.sign.tree</field>
        <field name="model">tsc.sign</field>
        <field name="arch" type="xml">
            <list string="Signing Records">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="doc_type"/>
                <field name="voffice_doc_id"/>
                <field name="voffice_status"/>
                <field name="sign_date"/>
            </list>
        </field>
    </record>

    <!-- Sign Search View -->
    <record id="tsc_sign_view_search" model="ir.ui.view">
        <field name="name">tsc.sign.search</field>
        <field name="model">tsc.sign</field>
        <field name="arch" type="xml">
            <search string="Search Signing Records">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="voffice_doc_id"/>
                <filter name="filter_pending" string="Pending" domain="[('voffice_status','=','pending')]"/>
                <filter name="filter_signed" string="Signed" domain="[('voffice_status','=','signed')]"/>
                <filter name="filter_published" string="Published" domain="[('voffice_status','=','published')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_status" string="VOffice Status" context="{'group_by':'voffice_status'}"/>
                    <filter name="group_doc_type" string="Document Type" context="{'group_by':'doc_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Sign Action -->
    <record id="tsc_sign_action" model="ir.actions.act_window">
        <field name="name">Signing Records</field>
        <field name="res_model">tsc.sign</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="tsc_sign_view_search"/>
    </record>
</odoo>
