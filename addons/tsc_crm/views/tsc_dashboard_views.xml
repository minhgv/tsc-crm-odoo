<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dashboard Form View -->
    <record id="tsc_dashboard_view_form" model="ir.ui.view">
        <field name="name">tsc.dashboard.form</field>
        <field name="model">tsc.dashboard</field>
        <field name="arch" type="xml">
            <form string="Dashboard" create="false">
                <div class="oe_title">
                    <h1><field name="name"/></h1>
                </div>

                <!-- Quick Actions -->
                <div class="d-flex gap-2 mb-4">
                    <button name="action_open_kanban" type="object" class="btn btn-primary btn-lg" icon="fa-th">
                        Kanban View
                    </button>
                    <button name="action_view_orders" type="object" class="btn btn-outline-primary btn-lg" icon="fa-list">
                        All Orders
                    </button>
                    <button name="action_view_overdue" type="object" class="btn btn-danger btn-lg" icon="fa-exclamation-triangle">
                        Overdue Orders
                    </button>
                </div>

                <!-- Technical Tasks -->
                <div class="d-flex gap-2 mb-4">
                    <button name="action_view_tech_tasks" type="object" class="btn btn-info btn-lg" icon="fa-wrench">
                        Technical Tasks
                    </button>
                    <button name="action_view_overdue_tasks" type="object" class="btn btn-warning btn-lg" icon="fa-clock-o">
                        Overdue Tasks
                    </button>
                </div>
            </form>
        </field>
    </record>

    <!-- Dashboard Action -->
    <record id="tsc_dashboard_action" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">tsc.dashboard</field>
        <field name="view_mode">form</field>
        <field name="context">{'default_name': 'TSC CRM Dashboard'}</field>
    </record>

    <!-- Orders Kanban by Stage -->
    <record id="tsc_orders_kanban_action" model="ir.actions.act_window">
        <field name="name">Orders by Stage</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban</field>
        <field name="domain">[('tsc_order_id', '!=', False)]</field>
        <field name="context">{'group_by': 'stage_id'}</field>
    </record>

    <!-- Orders by Region -->
    <record id="tsc_orders_by_region_action" model="ir.actions.act_window">
        <field name="name">Orders by Region</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban</field>
        <field name="domain">[('tsc_order_id', '!=', False)]</field>
        <field name="context">{'group_by': 'tsc_region_id'}</field>
    </record>
</odoo>
