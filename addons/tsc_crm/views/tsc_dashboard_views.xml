<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dashboard Form View -->
    <record id="tsc_dashboard_view_form" model="ir.ui.view">
        <field name="name">tsc.dashboard.form</field>
        <field name="model">tsc.dashboard</field>
        <field name="arch" type="xml">
            <form string="Dashboard" create="false">
                <div class="oe_title">
                    <h1><field name="name"/></h1>
                </div>
                <group>
                    <group string="Orders">
                        <button name="action_view_orders" type="object" class="btn btn-primary" string="View All Orders" icon="fa-list"/>
                        <button name="action_view_overdue" type="object" class="btn btn-danger" string="View Overdue Orders" icon="fa-exclamation-triangle"/>
                    </group>
                    <group string="Contracts &amp; Invoices">
                        <button name="action_view_contracts" type="object" class="btn btn-primary" string="View Contracts" icon="fa-file-text-o"/>
                        <button name="action_view_invoices" type="object" class="btn btn-primary" string="View Invoices" icon="fa-money"/>
                        <button name="action_view_payments" type="object" class="btn btn-primary" string="View Payments" icon="fa-credit-card"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <!-- Dashboard Action -->
    <record id="tsc_dashboard_action" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">tsc.dashboard</field>
        <field name="view_mode">form</field>
        <field name="context">{'default_name': 'TSC CRM Dashboard'}</field>
    </record>
</odoo>
