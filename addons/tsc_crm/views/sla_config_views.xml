<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SLA Config Form View -->
    <record id="tsc_sla_config_view_form" model="ir.ui.view">
        <field name="name">tsc.sla.config.form</field>
        <field name="model">tsc.sla.config</field>
        <field name="arch" type="xml">
            <form string="SLA Configuration">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="SLA Rule Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="stage"/>
                            <field name="applies_to"/>
                        </group>
                        <group>
                            <field name="max_hours"/>
                            <field name="warning_hours"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SLA Config Tree View -->
    <record id="tsc_sla_config_view_tree" model="ir.ui.view">
        <field name="name">tsc.sla.config.tree</field>
        <field name="model">tsc.sla.config</field>
        <field name="arch" type="xml">
            <list string="SLA Configurations">
                <field name="name"/>
                <field name="stage"/>
                <field name="max_hours"/>
                <field name="warning_hours"/>
                <field name="applies_to"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- SLA Config Search View -->
    <record id="tsc_sla_config_view_search" model="ir.ui.view">
        <field name="name">tsc.sla.config.search</field>
        <field name="model">tsc.sla.config</field>
        <field name="arch" type="xml">
            <search string="Search SLA Configs">
                <field name="name"/>
                <filter name="filter_active" string="Active" domain="[('active','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Stage" name="group_stage" context="{'group_by': 'stage'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- SLA Config Action -->
    <record id="tsc_sla_config_action" model="ir.actions.act_window">
        <field name="name">SLA Configuration</field>
        <field name="res_model">tsc.sla.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
