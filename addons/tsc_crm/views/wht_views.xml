<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WHT Form View -->
    <record id="tsc_wht_view_form" model="ir.ui.view">
        <field name="name">tsc.wht.form</field>
        <field name="model">tsc.wht</field>
        <field name="arch" type="xml">
            <form string="WHT Configuration">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="WHT Description"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Tax Information">
                            <field name="rate" widget="percentage"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Validity">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- WHT Tree View -->
    <record id="tsc_wht_view_tree" model="ir.ui.view">
        <field name="name">tsc.wht.tree</field>
        <field name="model">tsc.wht</field>
        <field name="arch" type="xml">
            <list string="WHT Configurations">
                <field name="name"/>
                <field name="rate" widget="percentage"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- WHT Action -->
    <record id="tsc_wht_action" model="ir.actions.act_window">
        <field name="name">WHT Configurations</field>
        <field name="res_model">tsc.wht</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
