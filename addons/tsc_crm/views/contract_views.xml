<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contract Form View -->
    <record id="tsc_contract_view_form" model="ir.ui.view">
        <field name="name">tsc.contract.form</field>
        <field name="model">tsc.contract</field>
        <field name="arch" type="xml">
            <form string="Contract">
                <header>
                    <button name="action_submit" string="Submit for Signing"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_sign" string="Mark as Signed"
                            type="object" class="oe_highlight"
                            invisible="state != 'pending_sign'"/>
                    <button name="action_activate" string="Activate"
                            type="object" class="oe_highlight"
                            invisible="state != 'signed'"/>
                    <button name="action_expire" string="Mark Expired"
                            type="object"
                            invisible="state not in ('active',)"/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state in ('expired', 'cancelled')"/>
                    <button name="action_reset_to_draft" string="Reset to Draft"
                            type="object"
                            invisible="state not in ('pending_sign', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending_sign,signed,active"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_order" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">View Order</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Contract Information">
                            <field name="lead_id"/>
                            <field name="partner_id"/>
                            <field name="contract_date"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group string="Financial">
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_total" widget="monetary"/>
                        </group>
                    </group>
                    <group string="VOffice Integration">
                        <group>
                            <field name="voffice_doc_id"/>
                            <field name="voffice_status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Documents" name="documents">
                            <group>
                                <field name="signed_file" filename="signed_filename"/>
                                <field name="signed_filename" invisible="1"/>
                                <field name="scan_file" filename="scan_filename"/>
                                <field name="scan_filename" invisible="1"/>
                            </group>
                        </page>
                        <page string="Signing Records" name="signs">
                            <field name="sign_ids">
                                <list editable="bottom">
                                    <field name="doc_type"/>
                                    <field name="voffice_doc_id"/>
                                    <field name="voffice_status"/>
                                    <field name="sign_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Contract notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Contract Tree View -->
    <record id="tsc_contract_view_tree" model="ir.ui.view">
        <field name="name">tsc.contract.tree</field>
        <field name="model">tsc.contract</field>
        <field name="arch" type="xml">
            <list string="Contracts">
                <field name="name"/>
                <field name="lead_id"/>
                <field name="partner_id"/>
                <field name="contract_date"/>
                <field name="state"/>
                <field name="voffice_status"/>
                <field name="amount_total" widget="monetary"/>
            </list>
        </field>
    </record>

    <!-- Contract Search View -->
    <record id="tsc_contract_view_search" model="ir.ui.view">
        <field name="name">tsc.contract.search</field>
        <field name="model">tsc.contract</field>
        <field name="arch" type="xml">
            <search string="Search Contracts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="lead_id"/>
                <filter name="filter_draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="filter_pending" string="Pending Signing" domain="[('state','=','pending_sign')]"/>
                <filter name="filter_signed" string="Signed" domain="[('state','=','signed')]"/>
                <filter name="filter_active" string="Active" domain="[('state','=','active')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_voffice" string="VOffice Status" context="{'group_by':'voffice_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Contract Action -->
    <record id="tsc_contract_action" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">tsc.contract</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="tsc_contract_view_search"/>
    </record>
</odoo>
