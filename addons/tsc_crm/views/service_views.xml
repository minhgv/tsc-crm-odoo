<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Service Form View -->
    <record id="tsc_service_view_form" model="ir.ui.view">
        <field name="name">tsc.service.form</field>
        <field name="model">tsc.service</field>
        <field name="arch" type="xml">
            <form string="Service">
                <header>
                    <button name="toggle_active" string="Archive"
                            type="object" class="oe_highlight"
                            invisible="active"/>
                    <button name="toggle_active" string="Unarchive"
                            type="object"
                            invisible="active == True"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_packages" type="object"
                                class="oe_stat_button" icon="fa-cubes">
                            <field name="total_packages" widget="statinfo" string="Packages"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="logo" widget="image" class="oe_avatar"
                           options="{'preview_image': 'logo'}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Service Name"/>
                        </h1>
                        <h3>
                            <field name="code" placeholder="Service Code"/>
                        </h3>
                    </div>
                    <group>
                        <group string="General Information">
                            <field name="service_type"/>
                            <field name="target_customer"/>
                            <field name="channel"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Media">
                            <field name="banner" widget="image"/>
                            <field name="video_url" placeholder="https://..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <group>
                                <field name="description" placeholder="Service description..."/>
                                <field name="value_proposition" placeholder="Value proposition..."/>
                                <field name="policies" placeholder="Policies..."/>
                            </group>
                        </page>
                        <page string="Packages" name="packages">
                            <field name="package_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Service Tree View -->
    <record id="tsc_service_view_tree" model="ir.ui.view">
        <field name="name">tsc.service.tree</field>
        <field name="model">tsc.service</field>
        <field name="arch" type="xml">
            <list string="Services">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="service_type"/>
                <field name="target_customer"/>
                <field name="total_packages"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Service Kanban View -->
    <record id="tsc_service_view_kanban" model="ir.ui.view">
        <field name="name">tsc.service.kanban</field>
        <field name="model">tsc.service</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="code"/>
                <field name="service_type"/>
                <field name="total_packages"/>
                <field name="logo"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('tsc.service', 'logo', record.id.raw_value)"
                                     t-att-alt="record.name.raw_value"
                                     class="o_kanban_image_fill"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="code"/>
                                </div>
                                <div>
                                    <field name="service_type"/>
                                </div>
                                <div>
                                    <field name="total_packages"/> packages
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Service Search View -->
    <record id="tsc_service_view_search" model="ir.ui.view">
        <field name="name">tsc.service.search</field>
        <field name="model">tsc.service</field>
        <field name="arch" type="xml">
            <search string="Search Services">
                <field name="name"/>
                <field name="code"/>
                <field name="service_type"/>
                <filter name="filter_active" string="Active"
                        domain="[('active','=',True)]"/>
                <filter name="filter_direct" string="Direct Sale"
                        domain="[('service_type','=','direct')]"/>
                <filter name="filter_project" string="Project"
                        domain="[('service_type','=','project')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Service Type"
                            context="{'group_by':'service_type'}"/>
                    <filter name="group_target" string="Target Customer"
                            context="{'group_by':'target_customer'}"/>
                    <filter name="group_channel" string="Channel"
                            context="{'group_by':'channel'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Service Action -->
    <record id="tsc_service_action" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">tsc.service</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="tsc_service_view_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>
</odoo>
