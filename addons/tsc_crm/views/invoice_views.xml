<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Invoice Form View -->
    <record id="tsc_invoice_view_form" model="ir.ui.view">
        <field name="name">tsc.invoice.form</field>
        <field name="model">tsc.invoice</field>
        <field name="arch" type="xml">
            <form string="Invoice">
                <header>
                    <button name="action_post" string="Post"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state in ('paid', 'cancelled', 'refund')"/>
                    <button name="action_draft" string="Reset to Draft"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    <button name="action_refund" string="Refund"
                            type="object"
                            invisible="state not in ('posted', 'paid')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_contract" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">View Contract</span>
                            </div>
                        </button>
                        <button name="action_view_payments" type="object"
                                class="oe_stat_button" icon="fa-money">
                            <div class="o_field_widget o_stat_info">
                                <field name="amount_paid" widget="statinfo" string="Paid"/>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Invoice Information">
                            <field name="contract_id"/>
                            <field name="lead_id"/>
                            <field name="partner_id"/>
                            <field name="invoice_date"/>
                            <field name="due_date"/>
                        </group>
                        <group string="Payment">
                            <field name="payment_method"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Invoice Lines" name="lines">
                            <field name="invoice_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit_price" widget="monetary"/>
                                    <field name="discount" widget="percentage"/>
                                    <field name="amount" widget="monetary"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tax" name="tax">
                            <group>
                                <group string="VAT">
                                    <field name="vat_rate" widget="percentage"/>
                                    <field name="vat_amount" widget="monetary"/>
                                </group>
                                <group string="WHT">
                                    <field name="wht_rate" widget="percentage"/>
                                    <field name="wht_amount" widget="monetary"/>
                                </group>
                            </group>
                            <group string="Totals">
                                <field name="amount_untaxed" widget="monetary"/>
                                <field name="amount_total" widget="monetary"/>
                            </group>
                        </page>
                        <page string="Payments" name="payments">
                            <field name="payment_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="amount" widget="monetary"/>
                                    <field name="payment_method"/>
                                    <field name="payment_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Invoice notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Invoice Tree View -->
    <record id="tsc_invoice_view_tree" model="ir.ui.view">
        <field name="name">tsc.invoice.tree</field>
        <field name="model">tsc.invoice</field>
        <field name="arch" type="xml">
            <list string="Invoices">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="invoice_date"/>
                <field name="due_date"/>
                <field name="amount_total" widget="monetary"/>
                <field name="amount_paid" widget="monetary"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Invoice Search View -->
    <record id="tsc_invoice_view_search" model="ir.ui.view">
        <field name="name">tsc.invoice.search</field>
        <field name="model">tsc.invoice</field>
        <field name="arch" type="xml">
            <search string="Search Invoices">
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="filter_draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="filter_posted" string="Posted" domain="[('state','=','posted')]"/>
                <filter name="filter_paid" string="Paid" domain="[('state','=','paid')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_date" string="Invoice Date" context="{'group_by':'invoice_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Invoice Action -->
    <record id="tsc_invoice_action" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">tsc.invoice</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="tsc_invoice_view_search"/>
    </record>
</odoo>
