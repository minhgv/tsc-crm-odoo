<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- CRM Team TSC Extension -->
    <record id="tsc_crm_team_view_form" model="ir.ui.view">
        <field name="name">crm.team.tsc.form</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='alias_id']" position="before">
                <field name="tsc_region_id"/>
                <field name="tsc_team_type"/>
                <field name="tsc_manager_id"/>
            </xpath>
        </field>
    </record>
</odoo>
