<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tsc_sla_violation_view_form" model="ir.ui.view">
        <field name="name">tsc.sla.violation.form</field>
        <field name="model">tsc.sla.violation</field>
        <field name="arch" type="xml">
            <form string="SLA Violation">
                <header>
                    <button name="action_resolve" string="Resolve"
                            type="object" class="oe_highlight"
                            invisible="resolved == True"/>
                    <button name="action_reopen" string="Reopen"
                            type="object"
                            invisible="resolved == False"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Violation Details">
                            <field name="lead_id"/>
                            <field name="sla_config_id"/>
                            <field name="stage_key"/>
                            <field name="violation_date"/>
                        </group>
                        <group string="Resolution">
                            <field name="resolved"/>
                            <field name="resolved_date"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="action_taken" placeholder="Action taken..."/>
                        <field name="notes" placeholder="Notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tsc_sla_violation_view_tree" model="ir.ui.view">
        <field name="name">tsc.sla.violation.tree</field>
        <field name="model">tsc.sla.violation</field>
        <field name="arch" type="xml">
            <list string="SLA Violations">
                <field name="name"/>
                <field name="lead_id"/>
                <field name="stage_key"/>
                <field name="violation_date"/>
                <field name="resolved"/>
            </list>
        </field>
    </record>

    <record id="tsc_sla_violation_action" model="ir.actions.act_window">
        <field name="name">SLA Violations</field>
        <field name="res_model">tsc.sla.violation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
