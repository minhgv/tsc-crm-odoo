<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tsc_sla_assignment" model="tsc.sla.config">
        <field name="name">Reception/Assignment SLA</field>
        <field name="stage">assignment</field>
        <field name="max_hours">4</field>
        <field name="warning_hours">2</field>
        <field name="applies_to">new_order</field>
    </record>

    <record id="tsc_sla_survey" model="tsc.sla.config">
        <field name="name">Survey/Consultation SLA</field>
        <field name="stage">survey</field>
        <field name="max_hours">24</field>
        <field name="warning_hours">18</field>
        <field name="applies_to">new_order</field>
    </record>

    <record id="tsc_sla_implementation" model="tsc.sla.config">
        <field name="name">Implementation SLA</field>
        <field name="stage">implementation</field>
        <field name="max_hours">48</field>
        <field name="warning_hours">36</field>
        <field name="applies_to">new_order</field>
    </record>

    <record id="tsc_sla_contract" model="tsc.sla.config">
        <field name="name">Contract Signing SLA</field>
        <field name="stage">contract</field>
        <field name="max_hours">72</field>
        <field name="warning_hours">48</field>
        <field name="applies_to">new_order</field>
    </record>

    <record id="tsc_sla_payment" model="tsc.sla.config">
        <field name="name">Payment SLA</field>
        <field name="stage">payment</field>
        <field name="max_hours">48</field>
        <field name="warning_hours">24</field>
        <field name="applies_to">new_order</field>
    </record>
</odoo>
