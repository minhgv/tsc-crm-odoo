<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Role Form -->
    <record id="tsc_role_view_form" model="ir.ui.view">
        <field name="name">tsc.role.form</field>
        <field name="model">tsc.role</field>
        <field name="arch" type="xml">
            <form string="Role">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Role Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Permissions" name="permissions">
                            <field name="permission_ids">
                                <list editable="bottom">
                                    <field name="permission_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Role Tree -->
    <record id="tsc_role_view_tree" model="ir.ui.view">
        <field name="name">tsc.role.tree</field>
        <field name="model">tsc.role</field>
        <field name="arch" type="xml">
            <list string="Roles">
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Role Action -->
    <record id="tsc_role_action" model="ir.actions.act_window">
        <field name="name">Roles</field>
        <field name="res_model">tsc.role</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Permission Form -->
    <record id="tsc_permission_view_form" model="ir.ui.view">
        <field name="name">tsc.permission.form</field>
        <field name="model">tsc.permission</field>
        <field name="arch" type="xml">
            <form string="Permission">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Permission Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="model_id"/>
                            <field name="operation"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Permission Tree -->
    <record id="tsc_permission_view_tree" model="ir.ui.view">
        <field name="name">tsc.permission.tree</field>
        <field name="model">tsc.permission</field>
        <field name="arch" type="xml">
            <list string="Permissions">
                <field name="name"/>
                <field name="code"/>
                <field name="model_id"/>
                <field name="operation"/>
            </list>
        </field>
    </record>

    <!-- Permission Action -->
    <record id="tsc_permission_action" model="ir.actions.act_window">
        <field name="name">Permissions</field>
        <field name="res_model">tsc.permission</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
