<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tsc_organization_view_form" model="ir.ui.view">
        <field name="name">tsc.organization.form</field>
        <field name="model">tsc.organization</field>
        <field name="arch" type="xml">
            <form string="Organization">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Organization Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="org_type"/>
                            <field name="division"/>
                        </group>
                        <group>
                            <field name="parent_id"/>
                            <field name="manager_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Children" name="children">
                            <field name="child_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tsc_organization_view_tree" model="ir.ui.view">
        <field name="name">tsc.organization.tree</field>
        <field name="model">tsc.organization</field>
        <field name="arch" type="xml">
            <list string="Organizations">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="org_type"/>
                <field name="division"/>
                <field name="parent_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="tsc_organization_view_search" model="ir.ui.view">
        <field name="name">tsc.organization.search</field>
        <field name="model">tsc.organization</field>
        <field name="arch" type="xml">
            <search string="Search Organizations">
                <field name="name"/>
                <field name="code"/>
                <filter name="filter_active" string="Active" domain="[('active','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_type" context="{'group_by': 'org_type'}"/>
                    <filter string="Division" name="group_division" context="{'group_by': 'division'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="tsc_organization_action" model="ir.actions.act_window">
        <field name="name">Organizations</field>
        <field name="res_model">tsc.organization</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
