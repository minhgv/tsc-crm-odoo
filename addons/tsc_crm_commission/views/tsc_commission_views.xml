<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tsc_commission_rule_view_form" model="ir.ui.view">
        <field name="name">tsc.commission.rule.form</field>
        <field name="model">tsc.commission.rule</field>
        <field name="arch" type="xml">
            <form string="Commission Rule">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="commission_type"/>
                            <field name="rate"/>
                            <field name="target_group"/>
                        </group>
                        <group>
                            <field name="service_id"/>
                            <field name="package_id"/>
                            <field name="agency_id"/>
                            <field name="min_revenue"/>
                            <field name="max_revenue"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tsc_commission_rule_view_tree" model="ir.ui.view">
        <field name="name">tsc.commission.rule.tree</field>
        <field name="model">tsc.commission.rule</field>
        <field name="arch" type="xml">
            <list string="Commission Rules">
                <field name="name"/>
                <field name="commission_type"/>
                <field name="rate"/>
                <field name="target_group"/>
                <field name="service_id"/>
            </list>
        </field>
    </record>

    <record id="tsc_commission_rule_action" model="ir.actions.act_window">
        <field name="name">Commission Rules</field>
        <field name="res_model">tsc.commission.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="tsc_commission_view_form" model="ir.ui.view">
        <field name="name">tsc.commission.form</field>
        <field name="model">tsc.commission</field>
        <field name="arch" type="xml">
            <form string="Commission">
                <header>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_pay" string="Mark Paid" type="object" class="oe_highlight" invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="agency_id"/>
                        </group>
                        <group>
                            <field name="lead_id"/>
                            <field name="invoice_id"/>
                            <field name="rule_id"/>
                            <field name="amount"/>
                            <field name="commission_date"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="tsc_commission_view_tree" model="ir.ui.view">
        <field name="name">tsc.commission.tree</field>
        <field name="model">tsc.commission</field>
        <field name="arch" type="xml">
            <list string="Commissions">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="agency_id"/>
                <field name="amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="tsc_commission_action" model="ir.actions.act_window">
        <field name="name">Commissions</field>
        <field name="res_model">tsc.commission</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
